# ============================================================
# Plantilla de .env para PRODUCCIÓN (cPanel / booking.tenri.cl)
# ------------------------------------------------------------
# Se copia UNA vez al servidor como ~/booking_backend/.env:
#   cp .env.production.example .env
#   php artisan key:generate
# y se completan las credenciales reales. El deploy por FTP
# NUNCA sube ni pisa el .env real (el zip excluye ".env").
# OJO: esta plantilla SÍ viaja en el zip y se pisa en cada deploy,
# por eso las credenciales van solo en el .env del servidor.
# ============================================================

APP_NAME="Tenri Barbería"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://booking.tenri.cl
# Necesario porque la app entra por public_html/api/index.php:
# sin esto, asset('storage/...') generaría URLs bajo /api/storage.
ASSET_URL=https://booking.tenri.cl
APP_TIMEZONE=America/Santiago

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL de cPanel (crear BD y usuario en el panel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database

# "database" requiere un cron en cPanel que procese la cola:
#   * * * * * cd ~/booking_backend && php artisan queue:work --stop-when-empty --tries=3 >> /dev/null 2>&1
# Si no configuras el cron, usa QUEUE_CONNECTION=sync
# (los emails se envían en línea, más lento pero sin worker).
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

# El frontend y la API comparten origen en producción,
# pero CORS debe apuntar igualmente al dominio real.
FRONTEND_URL=https://booking.tenri.cl
